{
  "manifest_version": 3,
  "name": "NFSU2 Clavier manette",
  "description": "Clavier virtuel manette/tactile et sortie Select+Start pour NFSU2 Revived (Foclabroc Toolbox).",
  "version": "1.1",
  "content_scripts": [
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://*.nfsu2.xyz/*"
      ],
      "js": [
        "main_world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://*.nfsu2.xyz/*"
      ],
      "js": [
        "padmap.js",
        "osk.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "bg.js"
  }
}
